<% layout("/layouts/boilerplate") %>
<div class="row mt-4">
  <div class="col-10 offset-1">
    <h2>Saved stays</h2>
    <p>Listings you have saved for later.</p>
    <% if(listings.length){ %>
      <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for(let listing of listings){ %>
          <div class="col">
            <div class="listing-card-wrap">
              <a href="/listings/<%=listing._id%>" class="listing-link">
                <div class="listing-card card">
                  <img src="<%=listing.image.url%>" class="card-img-top" alt="<%=listing.title%>" style="height: 20rem"/>
                  <div class="card-img-overlay"></div>
                  <div class="card-body">
                    <p class="card-text">
                      <b><%=listing.title%></b><br/>
                      <% if(listing.category){ %><span class="listing-category"><%=listing.category%></span><br/><% } %>
                      &#8377;<%=listing.price.toLocaleString("en-IN")%>/night
                    </p>
                  </div>
                </div>
              </a>
              <form method="post" action="/favorites/<%=listing._id%>/remove" class="favorite-form">
                <input type="hidden" name="returnTo" value="/favorites"/>
                <button class="favorite-button" type="submit" aria-label="Remove from saved stays" title="Remove from saved stays">
                  <i class="fa-solid fa-heart"></i>
                </button>
              </form>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="alert alert-info">You have not saved any stays yet.</div>
      <a class="btn btn-dark" href="/listings">Explore stays</a>
    <% } %>
  </div>
</div>
