<% layout("/layouts/boilerplate") %>
<body>
    <div class="row mt-3">
        <div class="col-6 offset-3">
            <h3 class="col-8 offset-3">SignUp on Wanderlust</h3>
            <form method="post" action="/signup" novalidate class="needs-validation">
                <div class="mb-3 mt-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" name="username" id="username" class="form-control" autocomplete="username" required/>
                    <div class="valid-feedback">Looks good!</div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" name="email" id="email" class="form-control" autocomplete="email" required/>
                    <div class="invalid-feedback">Enter a valid email-id</div>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" name="password" id="password" class="form-control" autocomplete="new-password" required/>
                    <div class="valid-feedback">Strong Password</div>
                    <div class="invalid-feedback">Please enter a strong password</div>
                </div>
                <button class="btn btn-outline-dark mt-3">SignUp</button>
            </form>
        </div>

    </div>
</body>